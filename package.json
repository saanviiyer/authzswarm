{
  "name": "authzswarm",
  "version": "0.1.0",
  "description": "Runs a swarm of security checks against your own apps and reports the bugs it finds.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "authzswarm": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "demo-target",
    "authorized-targets.json",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "security",
    "dast",
    "web-security",
    "pentest",
    "vulnerability-scanner",
    "authorized",
    "defensive-security",
    "appsec",
    "security-headers",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "test": "mkdir -p .tmp && TMPDIR=$PWD/.tmp npm run build && TMPDIR=$PWD/.tmp node --test dist/test/*.test.js",
    "demo:target": "npm run build && node dist/demo-target/server.js",
    "scan": "tsx src/cli.ts",
    "demo": "npm run build && node dist/scripts/demo.js",
    "start": "node dist/src/cli.js",
    "prepare": "tsc",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
